# Rizal Agent HQ — contoh konfigurasi (opsional, semua boleh dikosongkan).
# Salin ke .env atau export langsung; nilai default ada di crates/hq-server/src/main.rs.
# Port & bind
# HQ_PORT=8900
# HQ_BIND=127.0.0.1
# Interval pengumpulan snapshot, detik (default kode: 6)
# HQ_INTERVAL=6
# Folder data & web (relatif ke folder proyek saat jalan manual)
# HQ_DATA=data
# HQ_WEB=web
# Sumber data: kosong = semua; contoh membatasi hanya omp + cursor + Muse
# HQ_SOURCES=omp,cursor,Muse
# Sumber yang dimatikan, mis. mcp
# HQ_DISABLE_SOURCES=mcp
# Perapi LLM: on/off (default on; rantai model $0 dulu, lalu flash murah)
# HQ_LLM=on
# HQ_LLM_MODELS=
# Cap antrean + anggaran LLM (default kode: 8 / 20)
# HQ_LLM_MAX_PENDING=8
# HQ_LLM_MAX_PER_HOUR=20
# Tujuan install permanen (hanya dipakai scripts/install.sh)
# HQ_DEST=$HOME/rizal-agent-hq
# Harga saham live (opsional; hanya dari environment, jangan ditulis di repo).
# Pakai systemd drop-in: systemctl --user edit rizal-agent-hq.service
# EODHD_API_KEY=
# FMP_API_KEY=
# Pengetahuan Notion (opsional; token dari integrasi Notion, jangan ditulis di repo).
# Pakai systemd drop-in seperti kunci saham di atas.
# NOTION_API_KEY=
# Uji lokal: arahkan ke mock, dan/atau simulasikan tanggal WIB.
# EODHD_BASE_URL=https://eodhd.com
# FMP_BASE_URL=https://financialmodelingprep.com
# HQ_STOCKS_FAKE_WIB_DATE=
# HQ_STOCKS_FAKE_WIB_TIME=
